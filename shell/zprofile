# Runs per LOGIN SHELL — on this machine that means per kitty tab/window,
# not once per login session: kitty spawns each tab as a login shell (three
# ran concurrently when measured, 27-08-2026). The placement rule survives
# the correction — this still must not run for every `zsh -c` — but the
# cost multiplier is tabs, not logins.

# ── Homebrew (single source of truth) ─────────────────────
eval "$(/opt/homebrew/bin/brew shellenv)"

# ── SSH keys from macOS Keychain ──────────────────────────
ssh-add --apple-load-keychain 2>/dev/null

# ── Java ──────────────────────────────────────────────────
# `jset N` (defined in .zshrc) switches at runtime.
export JAVA_HOME="$(/usr/libexec/java_home -v 21)"
path=("$JAVA_HOME/bin" $path)

# ── pyenv — RETIRED 14-08-2026, replaced by mise ──────────
# mise owns python (and node) now; see the Runtimes block in .zshrc. pyenv
# stays installed but uninitialised so a rollback is restoring five lines
# rather than reinstalling a toolchain.
#
# Nothing replaces this block at login. pyenv split PATH-only init (here) from
# shim/widget init (.zshrc) to keep login shells cheap; `mise activate` does
# both jobs in one place and only in interactive shells — which is where node
# and python were already scoped, since the old nvm PATH prepend also lived in
# .zshrc. Scope is therefore unchanged by this migration, deliberately: GUI
# and cron launches could not see node or python before and still cannot.

# ── Installer-added paths ─────────────────────────────────
path=(
  "$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
  "/Applications/Obsidian.app/Contents/MacOS"
  "$HOME/.local/share/sonarqube-cli/bin"
  "$HOME/.sdkman/candidates/springboot/current/bin"
  $path
)
export PLAYDATE_SDK_PATH="$HOME/Developer/PlaydateSDK"

# Added by Antigravity CLI installer, kept as its marker so it doesn't
# re-append on update. ⚠️ NOT redundant, as this comment claimed until
# 27-08-2026: under `typeset -U` a re-assignment keeps the FIRST
# occurrence, so this line MOVES ~/.local/bin ahead of the claude-switch
# shim — measured: a login non-interactive shell resolved the real claude
# binary first, bypassing account routing. The re-front below restores the
# shim for that quadrant; .zshrc does the same for interactive shells.
export PATH="$HOME/.local/bin:$PATH"
path=("$HOME/.local/share/claude-switch/bin" $path)

# Machine-specific secrets and paths.
[ -f "$HOME/.zprofile.local" ] && source "$HOME/.zprofile.local"
