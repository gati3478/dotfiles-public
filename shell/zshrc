# Runs only in interactive shells. PATH and login-only setup live in
# .zshenv and .zprofile respectively.

# ── tmux (SSH only — Kitty is primary locally) ───────────
# Auto-attach for SSH sessions
if command -v tmux &>/dev/null && [[ -z "$TMUX" && $- == *i* && -n "$SSH_CONNECTION" ]]; then
  exec tmux new-session -A -s remote
fi

# ── History ──────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY
setopt EXTENDED_HISTORY
setopt HIST_FIND_NO_DUPS
# Adopted 26-08-2026 from the zshoptions(1) sweep: fcntl locking for the
# shared file (many concurrent shells write it), and dedupe at write-out —
# near-inert while HIST_IGNORE_ALL_DUPS keeps the in-memory list clean, and
# kept as the guard for what SHARE_HISTORY imports from other shells.
setopt HIST_FCNTL_LOCK
setopt HIST_SAVE_NO_DUPS

# ── Shell Options ────────────────────────────────────────
# Must precede the Completion block below: its 24h dump-staleness check
# uses the (#q…) glob-qualifier syntax, which requires EXTENDED_GLOB to
# be recognized at all. Without it, "#" has no special meaning, so the
# whole $ZCOMPDUMP(#qN.mh+24) token is just literal text concatenated
# onto the path — never empty, so the guard silently never fires and
# `compinit -C` (the cached fast path) never runs.
setopt EXTENDED_GLOB           # required by the (#q…) check in Completion
setopt AUTO_CD
setopt CORRECT
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP
setopt GLOB_DOTS
# Adopted 26-08-2026: `>` refuses to overwrite an existing file; `>|` is
# the deliberate override.
setopt NO_CLOBBER
# Adopted 27-08-2026 from the zsh 5.9 re-sweep (zshoptions/zshparam):
setopt ALWAYS_TO_END           # completing mid-word parks the cursor at word end
setopt COMPLETE_IN_WORD        # …and completes from both ends, not just the tail
setopt NO_FLOW_CONTROL         # an accidental Ctrl+S no longer wedges the terminal
# Spelling correction never offers completion functions (_git for a git typo).
CORRECT_IGNORE='_*'
# Commands over 10s of CPU time print timing stats unasked. CPU, not wall
# clock — a slow network wait never triggers it.
REPORTTIME=10
# Platform-standard word motion: every non-alphanumeric is a boundary, so
# option+arrow stops at path segments and Ctrl+W kills one segment, not the
# whole path. (zsh's default glues *?_-.[]~=/&;!#$%^(){}<> into words.)
WORDCHARS=''

# ── Completion ───────────────────────────────────────────
# Docker Desktop's zsh completion lives here.
fpath=(~/.docker/completions $fpath)
autoload -Uz compinit
# Versioned dump: a zsh upgrade changes the dump format, and `compinit -C`
# skips the staleness check, so an unversioned dump can produce broken
# completions for up to 24h after an upgrade. The version suffix makes an
# upgrade produce a cache miss instead of a stale hit.
ZCOMPDUMP="$HOME/.zcompdump-$ZSH_VERSION"
# Rebuild if older than 24h, otherwise use the cached fast path.
# ⚠️ Do NOT cite a saving here. traps.md's compinit entry measured the naive
# comparison and found the real everyday delta indistinguishable from noise;
# this line used to quote the misleading 0.22s-vs-0.02s figures it refutes.
if [[ -n $ZCOMPDUMP(#qN.mh+24) ]]; then
  compinit -d "$ZCOMPDUMP"
else
  compinit -C -d "$ZCOMPDUMP"
fi
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
# Coloured by file type in the terminal's 16 colours. The codes live HERE
# deliberately rather than in an exported LS_COLORS: eza reads LS_COLORS as
# an override, so exporting these would downgrade its richer per-extension
# built-ins (measured 27-08-2026 — eza's own defaults are pure 4-bit). The
# ${(s.:.)LS_COLORS} expansion this replaces was empty when measured
# (27-08-2026), and no managed file ever set the variable.
zstyle ':completion:*' list-colors 'di=01;34:ln=01;36:so=01;35:pi=33:ex=01;32:bd=01;33:cd=01;33:su=31:sg=31:tw=01;34:ow=01;34'
# Labelled sections instead of one pile, and a deterministic message instead
# of silence when nothing matches (adopted 27-08-2026, zshcompsys sweep).
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%B%d%b'
zstyle ':completion:*:warnings' format 'no matches: %d'
# brew install foo; foo<TAB> completes immediately — rehash on each search.
# The man page's speed caveat is about slow file access; PATH here is SSD.
zstyle ':completion:*' rehash true

# ── ssh/scp completion: offer hosts, not macOS service accounts ──────────
# `ssh <TAB>` was offering 146 candidates, ~129 of them macOS daemon users
# (_mds_stores, _amavisd, _spotlight …) pulled from the user database, which
# buried the 8 host aliases that actually exist. Measured 03-08-2026:
#   dscl . -list /Users | grep -c '^_'   ->  129
# Two independent fixes, because two completers contribute candidates:
#   1. stop offering system accounts as usernames at all
#   2. name the hosts explicitly, taken from ~/.ssh/config rather than from
#      known_hosts — known_hosts is the wrong source (hashed entries are
#      unreadable, and it lists hosts you visited once and never again)
zstyle ':completion:*:*:*:users' ignored-patterns '_*' daemon nobody root
_ssh_config_hosts=(${(f)"$(awk '/^[[:space:]]*[Hh]ost[[:space:]]/{for(i=2;i<=NF;i++) if ($i !~ /[*?!]/) print $i}' ~/.ssh/config 2>/dev/null)"})
zstyle ':completion:*:(ssh|scp|sftp|rsync|mosh|ssh-copy-id):*' hosts $_ssh_config_hosts

# ── Key Bindings ─────────────────────────────────────────
# history-search-backward matches on the FIRST WORD of the buffer only, so
# `git com` + Up searched for `git` and discarded `com` — it never did the
# prefix search its old comment claimed. history-beginning-search-backward
# matches the line up to the cursor, which is the intended behaviour.
# The -end variants additionally park the cursor at end of line rather
# than leaving it mid-line where the match happened to start.
autoload -Uz history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end  history-search-end
bindkey '^[[A' history-beginning-search-backward-end   # Up:   prefix search
bindkey '^[[B' history-beginning-search-forward-end    # Down: prefix search

# Pasted text renders plain, not standout — the last surface where a paste
# was not clean. Only the paste context is overridden; every other
# zle_highlight default stays (zshzle: "used to override a default").
zle_highlight=('paste:none')

# Ctrl+X Ctrl+E edits the buffer in $EDITOR (zed --wait), as in ksh — a
# multi-line command stops being nursed through ZLE. Creates a widget, so
# it must stay above the z-sy-h source line (adopted 27-08-2026).
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# ── Runtimes: node + python (mise) ───────────────────────
# Replaces pyenv AND nvm as of 14-08-2026. One binary, one config
# (~/.config/mise/config.toml), per-directory versions, and no lazy-loading
# shim to hand-write — the nvm block this removed existed only to defer a
# ~350 ms `nvm.sh` source that mise does not incur in the first place.
#
# Migrated versions are the ones that were live: node 24.16.0, python 3.12.x.
# ⚠️ python moved 3.12.2 -> 3.12.14 (same minor, latest patch). NOT cosmetic:
# mise refuses 3.12.2 because no GitHub artifact attestations exist for a
# Feb-2024 release. Disabling attestation verification was the alternative and
# was rejected — bypassing a supply-chain check to install an older
# interpreter is the wrong trade. All 36 packages from the pyenv environment
# were reinstalled and their imports verified.
#
# ⚠️ SDKMAN and `jset` are deliberately NOT migrated. mise wants to manage its
# own JDKs, which fights the Homebrew temurin casks already installed, and
# `jset` carries a guard against macOS `java_home` silently resolving to a
# non-matching JDK that mise offers no equivalent for.
#
# Rollback: delete this line, restore the pyenv blocks in .zprofile/.zshrc and
# the nvm block below. Both tools are still installed.
eval "$(mise activate zsh)"

# ── Java ─────────────────────────────────────────────────
# Default JDK is set once per login in .zprofile.
# `jset N` switches versions interactively (e.g. `jset 17`).
jset() {
  local v="${1:?usage: jset <java-version>}"
  local home actual
  home="$(/usr/libexec/java_home -v "$v" 2>/dev/null)" || {
    print -u2 "jset: no JDK matching '$v' (try '/usr/libexec/java_home -V')"
    return 1
  }
  # macOS java_home silently falls back to the latest installed JDK on a
  # non-matching version (exit 0). Confirm the resolved JDK's major version
  # actually matches the request before exporting.
  actual="$(awk -F'"' '/^JAVA_VERSION=/{print $2}' "$home/release" 2>/dev/null)"
  if [[ "${v%%.*}" != "${actual%%.*}" ]]; then
    print -u2 "jset: '$v' not installed — java_home fell back to JDK ${actual:-?}"
    return 1
  fi
  # Drop the previous JDK's bin from PATH so repeated switches don't
  # leave stale entries (typeset -U dedupes identical entries only).
  if [[ -n "$JAVA_HOME" ]]; then
    path=("${(@)path:#$JAVA_HOME/bin}")
  fi
  export JAVA_HOME="$home"
  path=("$JAVA_HOME/bin" $path)
}

# ── Modern CLI Tools ─────────────────────────────────────
# fzf 0.74 walks with its own built-in walker unless told otherwise (an
# earlier comment here said it shells out to `find` — refuted 26-08-2026
# against the installed man page). fd honours .gitignore and skips
# node_modules/target/build, so the finder searches what the repo considers
# real, by an explicit, asserted command.
#   --hidden       dotfiles are in scope (matches GLOB_DOTS above)
#   --exclude .git the one directory that is never the answer
# .gitignore is deliberately still honoured — the opposite of Zed's
# `search.include_ignored`, and for the opposite reason: Zed can afford to
# search ignored files because its file_scan_exclusions never walks the heavy
# build directories, whereas fzf here has no such exclusion list.
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'

# fzf rides the terminal's 16 ANSI colours instead of carrying its own —
# its unconfigured base scheme is a 256-colour "dark" palette of fzf's own,
# so silence does NOT comply here (unlike eza). Same rider rule as bat's
# --theme=ansi. Reaches zi too: zoxide passes FZF_DEFAULT_OPTS through to
# its fzf child unchanged (probe-measured 27-08-2026).
export FZF_DEFAULT_OPTS='--color=16'
# Previews answer "is this the one I mean?" before Enter. bat carries
# --theme=ansi from its config and eza's defaults are already 4-bit, so
# both previews stay in-palette (adopted 27-08-2026, fzf 0.74 sweep).
export FZF_CTRL_T_OPTS='--preview "bat --color=always --style=numbers --line-range=:200 {}"'
export FZF_ALT_C_OPTS='--preview "eza -1 --icons=auto --color=always {}"'

# Set BEFORE `fzf --zsh` below. The widgets read these at invocation rather
# than at bind time, so the order is not strictly required — but a reader
# should not have to know that to believe the block works.
# fzf's --zsh init binds ZLE widgets; guard for non-TTY interactive shells
# (e.g. Claude Code's `zsh -i -c`) where `setopt zle` errors out.
if [[ -t 1 ]]; then
  source <(fzf --zsh)
fi

# ── atuin: history as a queryable store ──────────────────
# Ordering matters — this must come AFTER `fzf --zsh` above, because both bind
# Ctrl+R and the last binding wins. That is the intended division:
#   Ctrl+R -> atuin  (history: SQLite-backed, scoped by directory/host/exit)
#   Ctrl+T -> fzf    (files)
#   Alt+C  -> fzf    (directories)
# fzf's Ctrl+R is a generic fuzzy filter over a flat file; atuin's knows what
# succeeded, where it ran, and when. Nothing is lost by conceding the key.
#
# ⚠️ --disable-up-arrow is REQUIRED, not cosmetic. atuin binds Up by default,
# which would silently replace the prefix search bound in the Key Bindings
# section above — a stated preference in the source repo's docs/preferences.md
# ("matches
# everything typed so far, not just the first word"), and one that cost a
# real bug to get right. Up/Down stay as they are.
#
# Local-only: no account, no sync — which is also why --disable-ai:
# atuin 18.19 binds `?` to Atuin AI by default (found by the 26-08-2026
# audit), and an AI keybinding has no place in a local-only history.
# ("no network" was overclaimed here until 27-08-2026: the update check —
# at most hourly, per 18.19's own needs_update_check — is on, deliberately;
# its notice is this surface's version-bump re-trigger signal, the same
# reasoning that kept kitty's 24h one.)
# `atuin import auto` seeded it from ~/.zsh_history on 14-08-2026; since
# 27-08-2026 config.toml is a manifest row (search-UI columns, workspaces,
# tmux popup — the sweep's adoptions).
#
# Guarded like fzf above: `zle -N` needs a real TTY, and Claude Code's
# `zsh -i -c` is interactive without one.
if [[ -t 1 ]]; then
  eval "$(atuin init zsh --disable-up-arrow --disable-ai)"
fi

# man renders unstyled without this; bat is already trusted as kitty's
# scrollback pager and carries `--theme=ansi` from ~/.config/bat/config, so
# man pages inherit the terminal palette rather than fighting it.
# (A MANROFFOPT='-c' for groff lived here — macOS man is mandoc and never
# reads it; measured 26-08-2026, removed.)
export MANPAGER="sh -c 'col -bx | bat --language=man --plain'"
eval "$(zoxide init zsh)"               # z <partial-path> to jump directories
# --hyperlink=auto (real terminals only) makes every entry kitty-clickable
# — the same instinct as hg below. Adopted 27-08-2026 from the eza sweep.
# The =auto is load-bearing, not style: bare --hyperlink greedily consumes
# the next positional, so `ls <path>` errors (caught by the 27-08 audit).
alias ls="eza --icons=auto --hyperlink=auto"
alias ll="eza -la --icons=auto --git --hyperlink=auto"
alias lt="eza -T --icons=auto --git-ignore --hyperlink=auto"
# (an `alias t` for LOCAL tmux attach lived here — deleted 27-08-2026: one
# recorded use ever, and a local session is what the SSH-only law prevents.)
alias hg='kitty +kitten hyperlinked_grep'  # Clickable grep results (open in editor)
alias fp='kitty +kitten choose-files'      # Keyboard file picker with previews

# ── Zsh Plugins ──────────────────────────────────────────
# Guarded: a fresh adopter without `brew install zsh-autosuggestions` gets
# a silent no-op here instead of a "no such file" error on every
# interactive shell. bootstrap's dependency check names the formula so it
# gets installed before this ever needs to fall back.
[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] && \
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# ── Starship Prompt ──────────────────────────────────────
eval "$(starship init zsh)"

# ── SDKMAN (lazy) ────────────────────────────────────────
# Spring Boot CLI is on PATH via .zprofile. Init only loads if you
# actually invoke `sdk` (install/upgrade/list/use).
export SDKMAN_DIR="$HOME/.sdkman"
sdk() {
  unfunction sdk
  source "$SDKMAN_DIR/bin/sdkman-init.sh"
  sdk "$@"
}

# ── nvm — RETIRED 14-08-2026, replaced by mise ───────────
# The lazy-load shim that lived here (PATH prepend of the newest installed
# node, plus a self-replacing `nvm` function deferring a ~350 ms nvm.sh) was
# a workaround for a cost mise does not have. Removing it removes the
# workaround, not a capability.
#
# ~/.nvm is left on disk untouched so rollback needs no reinstall. Nothing
# reads it any more — `nvm` is no longer a command in this shell, which is
# the intended outcome, not an oversight.

# Re-front the Claude account shim. `mise activate` above prepends its shim
# directory, which can land ahead of this one; re-fronting keeps the account
# shim ahead of the real binary. (Until 14-08-2026 the culprit named here was
# nvm's PATH prepend, which no longer exists.) See ~/.zshenv.
path=("$HOME/.local/share/claude-switch/bin" $path)

# Machine-specific overrides. Absent on a fresh clone, which is why the
# guard is here; on THIS machine it is a live manifest row.
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# ── zsh-syntax-highlighting — MUST BE LAST ───────────────
# Upstream: "must be sourced after all custom widgets have been created
# (i.e. after all `zle -N`)". `starship init zsh` creates a
# zle-keymap-select widget, so sourcing z-sy-h before starship left that
# widget unwrapped. Harmless on z-sy-h 0.8.0 + zsh 5.9, which prefer the
# order-insensitive zle-line-pre-redraw hook — but the widget-wrapping
# fallback path still exists, and the rule costs nothing to honour.
# Nothing that creates a ZLE widget may be added below this line.
# Guarded like zsh-autosuggestions above: absent -> silent no-op, not a
# "no such file" error on a fresh adopter's shell.
[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && \
  source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
