{
    // Gruvbox Dark Hard palette for the Terminus embedded terminal.
    //
    // Deploys to Packages/User/Terminus/ — NOT to Packages/User/ itself. The
    // file of the same name at the User root is 6.3 MB and machine-generated by
    // Terminus (tools/theme_generator.py); this small one is the authored
    // source it expands from. Tracking the generated file would version a build
    // artifact.
    //
    // Flipped light → dark hard 25-08-2026: Terminus is a terminal, and
    // § Colour's rule is dark where code runs — even inside a light editor.
    // Two explicit tiers (neutral + bright) replace the old l(+15%) transforms;
    // the values are the same canon the kitty theme carries.
    "name": "Terminus",
    "variables": {
        "background": "#1d2021",
        "foreground": "#ebdbb2",
        "black": "#3c3836",
        "red": "#cc241d",
        "green": "#98971a",
        "brown": "#d79921",
        "blue": "#458588",
        "magenta": "#b16286",
        "cyan": "#689d6a",
        "white": "#a89984",
        "light_black": "#928374",
        "light_red": "#fb4934",
        "light_green": "#b8bb26",
        "light_brown": "#fabd2f",
        "light_blue": "#83a598",
        "light_magenta": "#d3869b",
        "light_cyan": "#8ec07c",
        "light_white": "#fbf1c7",
        "caret": "#ebdbb2"
    },
    "globals": {
        "background": "#1d2021"
    }
}
