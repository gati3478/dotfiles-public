#!/usr/bin/env bash
# Adopt this setup on a fresh machine.
#
# Asks for the handful of values that are personal, writes them to a local
# overlay, patches the one config kitty itself cannot template, then
# symlinks the rest into place. Never overwrites without a backup (dot-apply
# owns that), and never runs as root.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ "$(id -u)" -eq 0 ]; then
  echo "bootstrap: refusing to run as root — this installs user files" >&2
  exit 1
fi

# Answers arrive on plain stdin: this is run from a clone, so stdin is the
# terminal. At end of input `read` returns non-zero and `set -e` stopped the
# script with no word said — a pipe, or `</dev/null`, printed a prompt and
# quit (14-09-2026).
ask() { # ask <prompt> <variable> — the line typed, or a stated stop
  printf '%s' "$1"
  if ! IFS= read -r "$2"; then
    printf '\nbootstrap: no answer on stdin — run it from a terminal, in a clone: ./bin/bootstrap\n' >&2
    exit 1
  fi
}

echo "== dependencies =="
missing=""
for tool in kitty zsh starship fzf zoxide eza bat git; do
  command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
done
# zsh-syntax-highlighting and zsh-autosuggestions are Homebrew formulae,
# not commands on PATH — `command -v` can't see them, so they need their
# own check. shell/zshrc guards both `source` lines, so a missing formula
# degrades to a silent no-op rather than an error on every shell — but an
# adopter who actually wants the plugins should still be told to install
# them, same as every other dependency here.
brew_missing=""
if command -v brew >/dev/null 2>&1; then
  for formula in zsh-syntax-highlighting zsh-autosuggestions; do
    brew list --formula "$formula" >/dev/null 2>&1 || brew_missing="$brew_missing $formula"
  done
else
  brew_missing=" zsh-syntax-highlighting zsh-autosuggestions"
fi
if [ -n "$missing$brew_missing" ]; then
  echo "Missing:$missing$brew_missing"
  echo "On macOS:  brew install${missing}${brew_missing}"
  echo "The font is separate:  brew install --cask font-fira-code-nerd-font"
  ask 'Continue anyway? [y/N] ' reply
  # `y` alone was the only accepted answer, and anything else left without a
  # word: a capital Y installed nothing and said nothing (14-09-2026).
  case "$reply" in
    [yY]*) ;;
    *) echo "bootstrap: stopped — nothing was changed. Install what is missing, then run this again." >&2; exit 1 ;;
  esac
fi

echo
echo "== your details =="
ask 'Full name for git commits: ' git_name
ask 'Email for git commits: '     git_email

cat > "$HOME/.gitconfig.local" <<EOF
[user]
	name = $git_name
	email = $git_email
EOF
echo "wrote ~/.gitconfig.local"

# The shell overlays are optional: the guards in zshenv/zprofile make an
# absent file a no-op, so an adopter with no work split needs neither.
touch "$HOME/.zshenv.local" "$HOME/.zprofile.local"
echo "wrote empty ~/.zshenv.local and ~/.zprofile.local (fill in if needed)"

echo
echo "== tab-title path =="
# terminal/kitty/kitty.conf's tab_title_template abbreviates the working
# directory to '~' via a Python .replace() call inside kitty's own config
# language. kitty.conf is not shell — that expression has no access to
# $HOME or any other env var, only the template's own data fields — so the
# home directory to collapse has to be a literal, authored for the original
# machine (/Users/gati3478). Rewrite it here instead, once, for this one.
#
# Idempotent: after the first run the literal is gone, so a re-run's grep
# finds nothing and this is a no-op. Uses a temp file + mv rather than
# sed -i, which takes an extra argument on macOS (BSD sed) and none on
# Linux (GNU sed) — portable either way.
KITTY_CONF="$REPO/terminal/kitty/kitty.conf"
ORIGINAL_HOME="/Users/gati3478"
if [ -f "$KITTY_CONF" ] && grep -q "$ORIGINAL_HOME" "$KITTY_CONF"; then
  tmp="$(mktemp)"
  sed "s|$ORIGINAL_HOME|$HOME|g" "$KITTY_CONF" > "$tmp" && mv "$tmp" "$KITTY_CONF"
  echo "patched tab_title_template in terminal/kitty/kitty.conf for \$HOME=$HOME"
else
  echo "tab_title_template already patched (or kitty.conf not found) — skipped"
fi

echo
echo "== deploying =="
"$REPO/bin/dot-apply"

echo
echo "Done. Open a new terminal window."
echo "Verify with: $REPO/bin/dot-doctor"
